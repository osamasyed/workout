{
  "name": "PPL Tracker",
  "short_name": "PPL",
  "description": "Dumbbell-only Push / Pull / Legs workout tracker with form pictures.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E1013",
